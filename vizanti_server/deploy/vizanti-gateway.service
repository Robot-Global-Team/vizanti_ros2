# vizanti 인증 게이트웨이 - 외부에 노출되는 유일한 vizanti 포트(5000)
# 독립 유닛인 이유: vizanti/nav 스택이 죽어도 안내 페이지와 인증 상태를 유지해야 함.
# 설치: install_vizanti_gateway.sh 가 /etc/systemd/system/ 에 복사 후 enable
[Unit]
Description=RGT vizanti authenticating gateway (port 5000)
After=network-online.target vizanti-firewall.service network-iface-auth.service
Wants=network-online.target network-iface-auth.service
# 무인 로봇: 영구 failed 가 재시작 루프보다 나쁨 -> 제한 없이 백오프 재시도
# (구버전 vizanti launch 가 5000 을 점유 중이면 nav 재시작 전까지 'address already in use' 로 재시도하는 것이 정상)
StartLimitIntervalSec=0

[Service]
Type=simple
User=rgt
Group=rgt
ExecStart=/usr/bin/python3 /opt/robot/rgt_ws/common/lib/vizanti_server/vizanti_gateway.py serve --auth-mode nif-device-v1
Restart=on-failure
RestartSec=3
RestartSteps=5
RestartMaxDelaySec=60
# 자원 상한: 비인가 연결 폭주가 fd/메모리/CPU 로 nav 스택을 건드리지 못하게
LimitNOFILE=16384
CPUAccounting=yes
CPUWeight=50
MemoryMax=256M
TasksMax=64
# 인증 이벤트는 stdout -> journald (journalctl -u vizanti-gateway). 게이트웨이가 <N> 우선순위 프리픽스를 붙임
StandardOutput=journal
StandardError=journal
SyslogLevelPrefix=true
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true

[Install]
WantedBy=multi-user.target
