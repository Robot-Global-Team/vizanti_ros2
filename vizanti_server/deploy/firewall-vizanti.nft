#!/usr/sbin/nft -f
# vizanti 포트 방화벽 벨트 (IPv4 + IPv6 — rosbridge 는 [::]:5001 에도 바인드됨)
#
# 적용 경로: /etc/vizanti-firewall.nft <- vizanti-firewall.service (install_vizanti_gateway.sh 가 설치)
# 멱등: 아래 2줄이 자기 테이블을 삭제 후 재생성하므로 몇 번 적용해도 룰이 누적되지 않음.
#
# Phase 0 (게이트웨이 설치 전, 3.3.0 로봇 임시 잠금): install_vizanti_gateway.sh firewall-only 를 쓸 것
#   (allow_gateway 줄이 제거된 파생본을 설치 -> 5000-5003 전부 외부 차단).
#   이 파일의 allow_gateway 줄을 주석 처리하는 것만으로는 부족하지 않음에 주의: 마지막 drop 이 5000 도 포함하므로
#   주석 처리해도 5000 이 닫히긴 하지만, 운영 절차는 installer 인자를 사용.
#
# 주의: rws_server 는 바인드 주소 옵션이 없어 전 인터페이스(5001)에 바인드됨 — 이 룰이 유일한 방어선.
# 주의: ufw 가 활성인 로봇은 ufw(priority 0) 의 정책이 별도로 평가됨 -> installer 가 `ufw allow 5000/tcp` 추가.

table inet vizanti_guard
delete table inet vizanti_guard

table inet vizanti_guard {
    chain input {
        # 우선순위: 기본 filter(0)보다 먼저 평가되도록 -10. drop 은 절대 판정, accept 는 뒤 체인으로 계속 평가됨
        type filter hook input priority -10; policy accept;

        # 로컬호스트는 무조건 허용 (게이트웨이 -> 백엔드 스플라이스, 탑재 GUI -> rosbridge 5001)
        iif "lo" accept

        # 게이트웨이 공개 포트: TLS 핸드셰이크 전 연결 폭주를 커널 단에서 선제 제한
        tcp dport 5000 ct state new meter vz_cnt4  { ip  saddr ct count over 16 } counter drop comment "gateway: per-source connection cap"
        tcp dport 5000 ct state new meter vz_cnt6  { ip6 saddr ct count over 16 } counter drop comment "gateway: per-source connection cap (v6)"
        tcp dport 5000 ct state new meter vz_rate4 { ip  saddr limit rate over 10/second burst 20 packets } counter drop comment "gateway: per-source rate"
        tcp dport 5000 ct state new meter vz_rate6 { ip6 saddr limit rate over 10/second burst 20 packets } counter drop comment "gateway: per-source rate (v6)"
        tcp dport 5000 ct state new limit rate over 100/second burst 60 packets counter drop comment "gateway: global rate backstop"
        tcp dport 5000 accept comment "allow_gateway"

        # vizanti 포트 전체: 외부에서 직접 접근 금지 (5000 은 위 accept 가 선행 터미널이라 게이트웨이 설치 시 열림)
        tcp dport 5000-5003 drop comment "vizanti: loopback only"
    }
}
